public class CalculatorWithStacticMethod {
    public static integer addition(Integer a, Integer b){
        integer c;
        c = a+b;
        system.debug('Addition is'+c);
        return c;
    }
    public static integer substraction(Integer a, Integer b){
        integer c;
        c = a-b;
        system.debug('Substraction is'+c);
        return c;
    }
     public static integer multiplication(Integer a, Integer b){
        integer c;
        c = a*b;
        system.debug('Multiplication is'+c);
        return c;
    }
     public static integer division(Integer a, Integer b){
        integer c;
        c = a/b;
        system.debug('division is'+c);
        return c;
    }



}