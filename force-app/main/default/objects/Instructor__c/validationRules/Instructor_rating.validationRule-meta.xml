<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Instructor_rating</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Rating__c &lt;1, Rating__c &gt; 5, ISBLANK(Rating__c))</errorConditionFormula>
    <errorDisplayField>Rating__c</errorDisplayField>
    <errorMessage>Instructor rating is required and must be between 1 and 5.</errorMessage>
</ValidationRule>
