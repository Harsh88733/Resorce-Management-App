<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Allocation_End_Greater_Than_Start</fullName>
    <active>true</active>
    <errorConditionFormula>Allocation_End_Date_Time__c &lt;= Allocation_Start_Date_Time__c</errorConditionFormula>
    <errorMessage>Allocation End Date Time must be greater than Allocation Start Date Time.</errorMessage>
</ValidationRule>
