<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Or_Phone_Required_On_Update</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISNEW()),
  ISBLANK(Email__c),
  ISBLANK(Phone__c)
)</errorConditionFormula>
    <errorMessage>Resource record must have either Email or Phone populated.</errorMessage>
</ValidationRule>
