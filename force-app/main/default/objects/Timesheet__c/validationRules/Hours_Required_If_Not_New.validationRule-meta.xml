<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hours_Required_If_Not_New</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISPICKVAL(Status__c, &quot;New&quot;)),
  OR(
    ISBLANK(Total_Hours__c),
    ISBLANK(Total_Billable_Hours__c)
  )
)</errorConditionFormula>
    <errorMessage>Total Hours and Total Billable Hours cannot be blank when status is changed from New</errorMessage>
</ValidationRule>
