<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manager_HR_Rating_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
  Manager_Rating__c &lt; 1,
  Manager_Rating__c &gt; 5,
  HR_Rating__c &lt; 1,
  HR_Rating__c &gt; 5
)</errorConditionFormula>
    <errorMessage>Manager Rating and HR Rating must both be between 1 and 5.</errorMessage>
</ValidationRule>
